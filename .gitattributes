# Normalise line endings in the repo; check out natively.
* text=auto

# Shell scripts must be LF or they fail with "bad interpreter" on Linux/macOS.
*.sh text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Markdown and JSON: LF in the repo, native on checkout.
*.md text
*.json text
